# Server-only backend origin used by the Next.js proxy.
WUCHAN_API_URL=http://localhost:3001

# Supabase Auth project. The publishable key may be exposed by the browser,
# but these values are consumed by Next.js route handlers here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Legacy compatibility if the project still exposes an anon key.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
