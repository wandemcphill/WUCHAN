NODE_ENV=development

# PostgreSQL connection. Required in production.
# Local: postgresql://postgres:postgres@localhost:5432/wuchan
# Supabase: session pooler URI on port 5432. Do not use the transaction pooler on port 6543.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wuchan

# Supabase JWT verification.
SUPABASE_JWT_SECRET=replace-with-project-jwt-secret
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Optional explicit PostgreSQL role used to execute authenticated RLS queries.
# Production defaults this to "authenticated".
# DATABASE_RLS_ROLE=authenticated

# Development-only auth bypass. Never set this in production.
ALLOW_DEV_AUTH=false
